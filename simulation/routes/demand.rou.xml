<?xml version="1.0" encoding="UTF-8"?>
<routes xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/routes_file.xsd">
    <vType id="passenger" vClass="passenger" accel="2.6" decel="4.5"
           sigma="0.5" length="5.0" minGap="2.5" maxSpeed="13.89"/>

    <route id="north_to_south" edges="north_in south_out"/>
    <route id="south_to_north" edges="south_in north_out"/>
    <route id="east_to_west" edges="east_in west_out"/>
    <route id="west_to_east" edges="west_in east_out"/>

    <!-- Probability is evaluated independently each second; the CLI seed makes it reproducible. -->
    <flow id="north_flow" type="passenger" route="north_to_south"
          begin="0" end="3600" probability="0.12" departLane="best"/>
    <flow id="south_flow" type="passenger" route="south_to_north"
          begin="0" end="3600" probability="0.12" departLane="best"/>
    <flow id="east_flow" type="passenger" route="east_to_west"
          begin="0" end="3600" probability="0.12" departLane="best"/>
    <flow id="west_flow" type="passenger" route="west_to_east"
          begin="0" end="3600" probability="0.12" departLane="best"/>
</routes>
